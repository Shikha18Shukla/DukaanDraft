# DukaanDraft environment configuration.
# Copy this file to `.env` and adjust values if needed.

# Local Ollama server (default is correct for most setups)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model that must be installed locally via `ollama pull gemma3:4b`
OLLAMA_MODEL=gemma3:4b

# Seconds to wait for the model to generate content
OLLAMA_TIMEOUT=120

# Maximum JSON request body size accepted by Flask (bytes)
MAX_CONTENT_LENGTH=8192
